# 在自己電腦上執行時用的設定範本 / Template for running on your own computer
# 1. 複製這個檔案，改名成 .env（.env 已經被 .gitignore 排除，不會被推上 GitHub）
#    Copy this file to .env (.env is git-ignored and never pushed)
# 2. 填好下面的值 / Fill in the values below
# 3. 執行 / Run:  node --env-file=.env update.mjs

# Discord 頻道的 Webhook 網址（機密，不要給別人）/ Discord channel webhook URL (keep secret)
DISCORD_WEBHOOK_URL=

# 要追蹤的實況主暱稱或玩家 ID / Streamer nickname or player ID
PLAYER=

# 顯示語言，跟 overlay 一樣的 16 種 / Display language (same 16 as the overlay)
LANGUAGE=zh-TW
